# Empty URL selects the synthetic demo. No secret needed to view the demo.
NEXT_PUBLIC_ENGINE_URL=
SARTORIA_ENV=dev
SARTORIA_ALLOW_INSECURE_DEV=0
# Set the same generated secret as the engine when using real measurements.
# Server-only: never prefix this variable with NEXT_PUBLIC_.
SARTORIA_TOKEN_SECRET=""
# Optional. Lets the tailor read typed answers (app/api/tailor) and the fit
# advisor explain a size (app/api/advisor). Server-only.
# Without it, typed answers are written on the ticket as they are and "Why this
# size?" shows only the calculator's own sentences.
ANTHROPIC_API_KEY=""
# Optional, for trying the fit advisor without a key: a template stand-in plays
# the model's part and says so on screen. Ignored when ANTHROPIC_API_KEY is set.
FIT_ADVISOR_DEMO=0
